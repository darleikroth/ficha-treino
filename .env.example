# Config web do Firebase. Copie para .env.local e preencha.
# Console → Configurações do projeto → Seus apps → Web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Obrigatória e NÃO vem no snippet padrão enquanto o Realtime Database não
# tiver sido criado. Formato: https://<instancia>.firebaseio.com (us-central1)
# ou https://<instancia>.<regiao>.firebasedatabase.app (demais regiões).
VITE_FIREBASE_DATABASE_URL=

# "true" aponta auth e database para os emuladores locais em vez da produção.
VITE_FIREBASE_EMULADOR=false
